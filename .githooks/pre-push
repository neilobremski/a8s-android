#!/usr/bin/env bash
# Block pushes whose tip won't compile, fails detekt, or fails unit tests.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] gradle: detekt + test + compileDebugKotlin"
./gradlew --no-daemon detekt test :app:compileDebugKotlin
